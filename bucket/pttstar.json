{
    "version": "4.0.0-beta.12",
    "description": "An unofficial PTT Client",
    "homepage": "https://www.ptt.cc/bbs/EZsoft/M.1546241396.A.D95.html",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "url": "https://download.ptt-star.com/PTTStar-4.0.0-beta.12.zip",
            "hash": "01116e500e230a9838515907bd9af46ab1ba72de884650f1be95b1c30531cf05"
        }
    },
    "extract_dir": "PTTStar-4.0.0-beta.12",
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\sPTT.ini\") -and !(Test-Path \"$dir\\sPTT.ini\")) {",
        "    Set-Content -LiteralPath \"$dir\\sPTT.ini\" -Value '[Basic]', 'AutoCheckUpdate=0' -Encoding UTF8 -ErrorAction Stop",
        "}",
        "foreach ($file in $manifest.persist) {",
        "    if (!(Test-Path \"$persist_dir\\$file\") -and !(Test-Path \"$dir\\$file\")) {",
        "        New-Item \"$dir\\$file\" -ItemType File | Out-Null",
        "    }",
        "}"
    ],
    "shortcuts": [
        [
            "PTTStar.exe",
            "PTT Star"
        ]
    ],
    "persist": [
        "black.txt",
        "black_title.txt",
        "bookmark.txt",
        "hot.txt",
        "hotboards.txt",
        "sPTT.ini",
        "track.txt"
    ],
    "checkver": {
        "url": "https://update.ptt-star.com/version.txt",
        "script": "$page.Split(\"`n\")[0].Trim().ToLowerInvariant() -replace '\\s+(alpha|beta|rc)\\s*(\\d+)', '-$1.$2'",
        "regex": "^([\\d.]+(?:-(?:alpha|beta|rc)\\.\\d+)?)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.ptt-star.com/PTTStar-$version.zip"
            }
        },
        "extract_dir": "PTTStar-$version"
    }
}
